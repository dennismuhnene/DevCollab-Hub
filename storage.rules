rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow public read access to all files.
    allow read;

    // Allow any authenticated user to write files.
    // The UI should enforce which users can upload to which paths.
    // This is a broader rule to ensure uploads are not blocked by permissions.
    allow write: if request.auth != null;

  }
}
