rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to all files
    match /{allPaths=**} {
      allow read;
    }

    // Allow write access to the 'images' folder for authenticated users.
    // Since the blog dashboard is only accessible to the admin, this is secure.
    match /images/{allPaths=**} {
      allow write: if request.auth != null;
    }

    // Existing rules for other parts of the app remain untouched and functional.
    match /profile-images/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /project-images/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
