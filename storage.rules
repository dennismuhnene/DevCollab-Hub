rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow public read access to all files.
    // This is necessary for images to be displayed in the app.
    match /{allPaths=**} {
      allow read;
    }

    // Allow authenticated users to write to their own designated folders.
    match /profile-images/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /project-images/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /blog-images/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /engagements/{engagementId}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == get(/databases/$(database)/documents/engagements/$(engagementId)).data.developerId || request.auth.uid == get(/databases/$(database)/documents/engagements/$(engagementId)).data.advisorId);
      allow write: if request.auth != null && (request.auth.uid == get(/databases/$(database)/documents/engagements/$(engagementId)).data.developerId || request.auth.uid == get(/databases/$(database)/documents/engagements/$(engagementId)).data.advisorId) && get(/databases/$(database)/documents/engagements/$(engagementId)).data.status == 'active';
    }
  }
}
