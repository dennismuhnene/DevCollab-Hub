rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to all files.
    match /{allPaths=**} {
      allow read;
    }

    // Allow write access for any authenticated user to any path.
    // The application's UI logic already restricts who can upload and where.
    match /{allPaths=**} {
      allow write: if request.auth != null;
    }
  }
}
