rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow public read access to all files so images can be displayed in the app.
    allow read;

    // Allow a user to write to their own folder within profile-images.
    match /profile-images/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow a user to write to their own folder within project-images.
    match /project-images/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow a user (in this case, the admin) to write to their own folder within blog-images.
    // This rule now correctly matches the pattern used elsewhere in the app.
    match /blog-images/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
