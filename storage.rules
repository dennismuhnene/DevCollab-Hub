rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to all files
    match /{allPaths=**} {
      allow read;
    }

    // Allow write access to the 'images' folder only for authenticated users
    match /images/{allPaths=**} {
      allow write: if request.auth != null;
    }

    // Allow write access for authenticated users to their own profile image folder
    match /profile-images/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow write access for authenticated users to their own project image folder
    match /project-images/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
