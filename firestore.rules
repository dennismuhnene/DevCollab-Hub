rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }

    // USERS
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn() && uid() == userId;

      // Allow a user to read, update, or delete their own notifications.
      // Allow any signed-in user to create a notification for another user.
      match /notifications/{notificationId} {
        allow read, update, delete: if isSignedIn() && uid() == userId;
        allow create: if isSignedIn();
      }
    }

    // PROJECTS
    match /projects/{projectId} {
      // Basic read permissions for signed-in users
      allow get, list: if isSignedIn();

      // Create: only when the ownerId in new doc equals request.auth.uid
      allow create: if isSignedIn() && request.resource.data.ownerId == uid();

      // Update:
      // - Owner can update any fields on their own project.
      // - Non-owner users may only modify the 'interestedUsers' array.
      allow update: if isSignedIn() && (
        resource.data.ownerId == uid()
        ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestedUsers'])
      );

      // Delete: only owner can delete
      allow delete: if isSignedIn() && resource.data.ownerId == uid();
    }

    // MATCHES
    match /matches/{matchId} {

      function hasParticipants() {
        return resource.data.keys().hasAll(['participants'])
          && resource.data.participants is list;
      }

      // Allow any participant to read this match
      allow read: if isSignedIn() && hasParticipants() && uid() in resource.data.participants;

      // When creating a match, the new document must contain a 'participantsDetails' map
      // and the current user must be one of the participants.
      allow create: if isSignedIn()
          && request.resource.data.keys().hasAll(['participants', 'participantsDetails'])
          && request.resource.data.participants is list
          && uid() in request.resource.data.participants;

      // Allow participants to update the match (e.g., for last message timestamp)
      allow update: if isSignedIn()
          && hasParticipants()
          && uid() in resource.data.participants;

      // Do not allow matches to be deleted.
      allow delete: if false;

      // This function ensures a 'list' query is ONLY allowed if it filters by
      // the 'participants' field, ensuring users only see their own matches.
      function isQueryingOwnMatches() {
        return request.query.keys().hasAny(['where'])
          && request.query.where.size() > 0
          && request.query.where[0][0] == 'participants'
          && request.query.where[0][1] == 'array-contains'
          && request.query.where[0][2] == uid();
      }

      allow list: if isSignedIn() && isQueryingOwnMatches();

      // Message subcollection
      match /messages/{messageId} {
        function isParticipant() {
          return exists(/databases/$(database)/documents/matches/$(matchId))
            && uid() in get(/databases/$(database)/documents/matches/$(matchId)).data.participants;
        }

        allow read, get, list: if isSignedIn() && isParticipant();
        allow create: if isSignedIn() && isParticipant() && request.resource.data.senderId == uid();
        allow update, delete: if false;
      }
    }
  }
}
