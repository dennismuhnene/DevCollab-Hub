/**
 * @fileoverview Firestore Security Rules for DevCollab Hub.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and projects.
 * It uses denormalization to avoid costly `get()` calls and ensures authorization independence.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles. User's can only read/write their own profile.
 * - /projects/{projectId}: Stores project information. Only authenticated users can read/write.
 * - /users/{userId}/projects/{projectId}: Subcollection for projects owned by a specific user.
 * - /matches/{matchId}: Stores match data between users and projects.
 * - /projects/{projectId}/matches/{matchId}: Subcollection for matches related to a specific project.
 *
 * Key Security Decisions:
 * - Users can only access their own profile data.
 * - Project modifications are restricted to the project owner.
 * - Denormalization of ownerId and userId ensures authorization independence.
 * - All write operations validate the existence of the document being modified/deleted.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Controls access to user profiles. Only the authenticated user can read/write their own profile.
     * @path /users/{userId}
     * @allow (create) - Authenticated user creates their profile with a matching userId.
     * @allow (get, list, update, delete) - Authenticated user reads/writes their own profile.
     * @deny (create, get, list, update, delete) - Any other user attempts to access another user's profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get, list: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to projects. Only authenticated users can read/write.
     * @path /projects/{projectId}
     * @allow (create) - Authenticated user creates a project with their userId as ownerId.
     * @allow (get, list) - Any authenticated user can read project information.
     * @allow (update, delete) - Only the project owner can modify or delete the project.
     * @deny (create, update, delete) - Any user tries to create a project as another user, or modify/delete a project they don't own.
     * @principle Enforces document ownership for writes.
     */
    match /projects/{projectId} {
      function isOwner(ownerId) {
        return request.auth.uid == ownerId;
      }

      function isExistingOwner(ownerId) {
        return isOwner(ownerId) && resource != null;
      }

      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isOwner(request.resource.data.ownerId) && request.resource.data.ownerId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.ownerId);
      allow delete: if isExistingOwner(resource.data.ownerId);
    }

    /**
     * @description Controls access to projects nested under users. Enforces strict user ownership.
     * @path /users/{userId}/projects/{projectId}
     * @allow (create) - User creates a project under their own userId.
     * @allow (get, list, update, delete) - Only the project owner can access.
     * @deny (create, get, list, update, delete) - Any other user attempts to access.
     * @principle Enforces strict document ownership.
     */
    match /users/{userId}/projects/{projectId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.ownerId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.ownerId == userId;
      allow delete: if isExistingOwner(userId) && request.resource.data.ownerId == userId;
    }

    /**
     * @description Controls access to matches. Checks that the user is creating/modifying matches related to their projects.
     * @path /matches/{matchId}
     * @allow (create) - Authenticated user can create match if they are related to the project or user involved.
     * @allow (get, list) - Any authenticated user can read match information.
     * @allow (update, delete) - Only the project owner or user involved can modify.
     * @deny (create, update, delete) - Any user tries to create a match for another user's project.
     * @principle Controls access based on user and project relationship.
     */
    match /matches/{matchId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Controls access to matches nested under projects.
     * @path /projects/{projectId}/matches/{matchId}
     * @allow (create) - Authenticated user can create matches under the project.
     * @allow (get, list) - Any authenticated user can read matches related to the project.
     * @allow (update, delete) - Project owner and user involved can modify.
     * @deny (create, update, delete) - Other users cannot create or modify matches.
     * @principle Controls access based on project ownership.
     */
    match /projects/{projectId}/matches/{matchId} {
      function isProjectOwner(projectId) {
        return get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
      }

      function isExistingProjectOwner(projectId) {
          return isProjectOwner(projectId) && resource != null;
      }

      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }
  }
}
