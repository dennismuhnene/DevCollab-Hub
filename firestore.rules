
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    // Securely checks if the user is an admin
    function isAdmin() {
      return request.auth.token.get('admin', false) == true || request.auth.uid == 'Jv4XV8flpAgUqJpd2P7SKr3PijX2';
    }

    // Rule for Admin Page: Allows admins to query all applications
    match /{path=**}/advisorApplications/{applicationId} {
      allow list: if isAdmin();
    }

    // USERS
    match /users/{userId} {
      // This permissive rule is required by pages like /developers to list users.
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      
      // Allow user to create their own profile
      allow create: if isSignedIn() && uid() == userId;

      // Secure update rule: Prevents users from escalating their own privileges.
      allow update: if
        isAdmin()
      ||
        (
          uid() == userId &&
          // Prevent self-admin promotion
          !(
            resource.data.get('roles', {}).get('admin', false) == false &&
            request.resource.data.get('roles', {}).get('admin', false) == true
          ) &&
          // Prevent self-verification
          !(
            resource.data.get('advisorProfile', {}).get('verificationStatus', '') != 'verified' &&
            request.resource.data.get('advisorProfile', {}).get('verificationStatus', '') == 'verified'
          )
        ) ||
        (uid() == userId &&
          // Allow a user to ONLY update their own blocked list
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blockedUsers']) 
        );

      allow delete: if false;

      // Advisor Applications Subcollection
      match /advisorApplications/{applicationId} {
        allow get, list: if isSignedIn() && (uid() == userId || isAdmin());
        allow create: if isSignedIn() && uid() == userId;
        // UPDATED RULE: Allows a user to either update their application without changing the verification
        // status, OR to change the status from 'rejected' back to 'pending' upon resubmission.
        allow update: if isSignedIn() && (isAdmin() || (uid() == userId && (request.resource.data.verificationStatus == resource.data.verificationStatus || (resource.data.verificationStatus == 'rejected' && request.resource.data.verificationStatus == 'pending'))));
        allow delete: if false;
      }

      // User's own notifications
      match /notifications/{notificationId} {
        allow read, list, update, delete: if isSignedIn() && uid() == userId;
        allow create: if isSignedIn(); // Other users/functions can create notifications for this user
      }
      
      // User's own views
      match /views/{viewId} {
        allow read, list: if isSignedIn() && uid() == userId;
        allow create: if isSignedIn() && request.resource.data.visitorId == uid();
      }
    }
    
    // Public profiles for verified advisors
    match /publicAdvisorProfiles/{advisorId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false; // Managed by backend functions
    }

    // PROJECTS
    match /projects/{projectId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == uid();
      allow update: if isSignedIn() && (resource.data.ownerId == uid() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestedUsers', 'rejections']));
      allow delete: if isSignedIn() && resource.data.ownerId == uid();

      match /views/{viewId} {
          allow read, list: if isSignedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == uid();
          allow create: if isSignedIn() && request.resource.data.visitorId == uid();
      }
    }

    // ROLES
    match /roles/{roleId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == uid();
      allow update: if isSignedIn() && (resource.data.ownerId == uid() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestedUsers', 'rejections']));
      allow delete: if isSignedIn() && resource.data.ownerId == uid();
    }

    // BLOGS
    match /blogs/{blogId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn(); // Logic handled in app
    }

    // MATCHES & MESSAGES
    match /matches/{matchId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.keys().hasAll(['participants', 'participantsDetails']) && request.resource.data.participants is list && uid() in request.resource.data.participants;
      allow update: if isSignedIn() && uid() in resource.data.participants;
      allow delete: if false;
      
      match /messages/{messageId} {
        function isParticipant() {
          return exists(/databases/$(database)/documents/matches/$(matchId)) && uid() in get(/databases/$(database)/documents/matches/$(matchId)).data.participants;
        }
        allow read, get, list: if isSignedIn() && isParticipant();
        allow create: if isSignedIn() && isParticipant() && request.resource.data.senderId == uid();
        allow update: if isSignedIn() && isParticipant() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor']) && uid() in request.resource.data.deletedFor;
        allow delete: if false;
      }
    }

    // FEEDBACK
    match /feedback/{feedbackId} {
      allow create: if isSignedIn();
      allow read, list: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ENGAGEMENTS & REVIEWS
    match /engagements/{engagementId} {
      allow create: if isSignedIn() && request.resource.data.developerId == uid();
      allow read: if isSignedIn() && (uid() == resource.data.developerId || uid() == resource.data.advisorId);
      allow get: if isSignedIn();
      // FINAL SECURITY RULE: Meeting management is now handled exclusively by the 'manageMeeting' Cloud Function.
      // Client-side updates are restricted to status changes only.
      allow update: if isSignedIn() && (
        (resource.data.status == 'requested' && request.resource.data.status == 'active' && uid() == resource.data.advisorId) ||
        (resource.data.status == 'requested' && request.resource.data.status == 'rejected' && uid() == resource.data.advisorId) ||
        (resource.data.status == 'active' && request.resource.data.status == 'closed' && (uid() == resource.data.developerId || uid() == resource.data.advisorId))
      );

      match /messages/{messageId} {
          allow read, write: if isSignedIn() && (uid() == get(/databases/$(database)/documents/engagements/$(engagementId)).data.developerId || uid() == get(/databases/$(database)/documents/engagements/$(engagementId)).data.advisorId) && (get(/databases/$(database)/documents/engagements/$(engagementId)).data.status == 'active' || get(/databases/$(database)/documents/engagements/$(engagementId)).data.status == 'requested');
      }
    }
    match /advisor_reviews/{reviewId} {
        allow create: if isSignedIn() && exists(/databases/$(database)/documents/engagements/$(request.resource.data.engagementId)) && get(/databases/$(database)/documents/engagements/$(request.resource.data.engagementId)).data.status == 'closed' && get(/databases/$(database)/documents/engagements/$(request.resource.data.engagementId)).data.developerId == uid() && request.resource.data.advisorId == get(/databases/$(database)/documents/engagements/$(request.resource.data.engagementId)).data.advisorId && !exists(/databases/$(database)/documents/advisor_reviews/{reviewId});
        allow update: if isSignedIn() && uid() == resource.data.advisorId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['advisorResponse']);
    }
  }
}
