rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function isAdmin() {
      return request.auth.token.get('admin', false) == true || request.auth.uid == 'Jv4XV8flpAgUqJpd2P7SKr3PijX2';
    }

    // Collection Group Rules
    match /{path=**}/advisorApplications/{applicationId} {
      allow list: if isSignedIn();
    }

    // USERS
    match /users/{userId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && uid() == userId;
        allow update: if
            isAdmin()
        ||
            (
            uid() == userId &&
            !(
                resource.data.get('roles', {}).get('admin', false) == false &&
                request.resource.data.get('roles', {}).get('admin', false) == true
            ) &&
            !(
                resource.data.get('advisorProfile', {}).get('verificationStatus', '') != 'verified' &&
                request.resource.data.get('advisorProfile', {}).get('verificationStatus', '') == 'verified'
            )
            ) ||
            (uid() == userId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blockedUsers'])
            );
        allow delete: if false;

        match /advisorApplications/{applicationId} {
            allow get: if isSignedIn() && (isAdmin() || uid() == userId || resource.data.verificationStatus == 'verified');
            allow list: if isSignedIn();
            allow create: if isSignedIn() && uid() == userId;
            allow update: if isSignedIn() && (isAdmin() || (uid() == userId && (request.resource.data.verificationStatus == resource.data.verificationStatus || (resource.data.verificationStatus == 'rejected' && request.resource.data.verificationStatus == 'pending'))));
            allow delete: if false;
        }

        match /notifications/{notificationId} {
            allow read, list, update, delete: if isSignedIn() && uid() == userId;
            allow create: if isSignedIn(); 
        }

        match /views/{viewId} {
            allow read, list: if isSignedIn() && uid() == userId;
            allow create: if isSignedIn() && request.resource.data.visitorId == uid();
        }
    }

    // Public profiles for verified advisors
    match /publicAdvisorProfiles/{advisorId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    // PROJECTS
    match /projects/{projectId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == uid();
      allow update: if isSignedIn() && (resource.data.ownerId == uid() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestedUsers', 'rejections']));
      allow delete: if isSignedIn() && resource.data.ownerId == uid();

      match /views/{viewId} {
          allow read, list: if isSignedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == uid();
          allow create: if isSignedIn() && request.resource.data.visitorId == uid();
      }
    }

    // ROLES
    match /roles/{roleId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == uid();
      allow update: if isSignedIn() && (resource.data.ownerId == uid() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestedUsers', 'rejections']));
      allow delete: if isSignedIn() && resource.data.ownerId == uid();
    }

    // BLOGS
    match /blogs/{blogId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    // MATCHES & MESSAGES
    match /matches/{matchId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.keys().hasAll(['participants', 'participantsDetails']) && request.resource.data.participants is list && uid() in request.resource.data.participants;
      allow update: if isSignedIn() && uid() in resource.data.participants && (
          // Allow updating standard fields like last message, unread counts, etc.
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessage', 'lastMessageSender', 'lastMessageTimestamp', 'unreadCounts']) ||
          // Allow archiving/unarchiving
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archivedBy']) ||
          // Allow deleting/undeleting for the user
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedBy'])
      );
      allow delete: if false;

      match /messages/{messageId} {
        function isParticipant() {
          return exists(/databases/$(database)/documents/matches/$(matchId)) && uid() in get(/databases/$(database)/documents/matches/$(matchId)).data.participants;
        }
        allow read, get, list: if isSignedIn() && isParticipant();
        allow create: if isSignedIn() && isParticipant() && request.resource.data.senderId == uid();
        allow update: if isSignedIn() && isParticipant() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor']) && uid() in request.resource.data.deletedFor;
        allow delete: if false;
      }
    }

    // FEEDBACK
    match /feedback/{feedbackId} {
      allow create: if isSignedIn();
      allow read, list: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ENGAGEMENTS & REVIEWS
    match /engagements/{engagementId} {
      // Helper functions for this resource
      function isDeveloper() { return uid() == resource.data.developerId; }
      function isAdvisor() { return uid() == resource.data.advisorId; }
      function isParticipant() { return isDeveloper() || isAdvisor(); }
      function statusTransition(before, after) {
        return resource.data.status == before && request.resource.data.status == after;
      }
      function affectedKeysAre(keys) {
          let allKeys = keys.concat(['status']);
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allKeys);
      }
      function statusOnly() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      }

      allow create: if isSignedIn() && request.resource.data.developerId == uid();
      allow read, get: if isSignedIn() && isParticipant();

      allow update: if isSignedIn() && (
        (isParticipant() && (
            // Advisor submits initial proposal or a revision
            ( (statusTransition('pending_proposal', 'pending_developer_acceptance') || statusTransition('revision_requested', 'pending_developer_acceptance')) && 
                isAdvisor() && affectedKeysAre(['advisorProposal']) ) ||
            // Advisor rejects initial request or revision request
            ( (statusTransition('pending_proposal', 'rejected') || statusTransition('revision_requested', 'rejected')) && 
                isAdvisor() && statusOnly() ) ||
            
            // Developer requests revision
            ( statusTransition('pending_developer_acceptance', 'revision_requested') && 
                isDeveloper() && affectedKeysAre(['developerRevisionNote']) ) ||
            // Developer accepts proposal
            ( statusTransition('pending_developer_acceptance', 'active') && 
                isDeveloper() && affectedKeysAre(['activatedAt']) ) ||
            // Developer rejects proposal
            ( statusTransition('pending_developer_acceptance', 'rejected') && 
                isDeveloper() && statusOnly() ) ||

            // Either participant closes the engagement
            ( statusTransition('active', 'closed') && 
                isParticipant() && affectedKeysAre(['closedById']) ) ||

            // A participant can archive/unarchive for themselves.
            ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archivedBy']) &&
              (request.resource.data.archivedBy == (resource.data.get('archivedBy', [])).concat([uid()])) ||
              (request.resource.data.archivedBy == (resource.data.get('archivedBy', [])).removeAll([uid()])) )
        )) ||
        // Admin-only action to mark engagement as having a deleted participant
        (isAdmin() && request.resource.data.status == 'participant_deleted')
      );

      match /messages/{messageId} {
          allow read: if isSignedIn() && (uid() == get(/databases/$(database)/documents/engagements/$(engagementId)).data.developerId || uid() == get(/databases/$(database)/documents/engagements/$(engagementId)).data.advisorId);
          allow write: if isSignedIn() && (uid() == get(/databases/$(database)/documents/engagements/$(engagementId)).data.developerId || uid() == get(/databases/$(database)/documents/engagements/$(engagementId)).data.advisorId) && get(/databases/$(database)/documents/engagements/$(engagementId)).data.status == 'active';
      }
    }
     match /advisor_reviews/{reviewId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() &&
            exists(/databases/$(database)/documents/engagements/$(request.resource.data.engagementId)) &&
            get(/databases/$(database)/documents/engagements/$(request.resource.data.engagementId)).data.status == 'closed' &&
            get(/databases/$(database)/documents/engagements/$(request.resource.data.engagementId)).data.developerId == uid() &&
            get(/databases/$(database)/documents/engagements/$(request.resource.data.engagementId)).data.advisorId == request.resource.data.advisorId;
        allow update: if isSignedIn() && uid() == resource.data.advisorId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['advisorResponse']);
    }
  }
}
