rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Simple helpers
    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }

    // -----------------------
    // USERS
    // -----------------------
    match /users/{userId} {
      // Any signed-in user may read user profiles (public).
      allow get: if isSignedIn();
      allow list: if isSignedIn(); 

      // Only the owner can create/update/delete their profile document
      allow create, update, delete: if isSignedIn() && uid() == userId;

      // Notifications: only the user can access their own notifications subcollection
      match /notifications/{notificationId} {
        allow read, write, delete: if isSignedIn() && uid() == userId;
      }
    }

    // -----------------------
    // PROJECTS (top-level)
    // -----------------------
    match /projects/{projectId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn() && request.resource.data.ownerId == uid();

      allow update: if isSignedIn() &&
        (
          (resource.data.ownerId == uid())
          ||
          (
            request.resource.data.keys().hasAll(resource.data.keys()) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestedUsers','matchedUsers'])
          )
        );

      allow delete: if isSignedIn() && resource.data.ownerId == uid();
    }

    // -----------------------
    // MATCHES (top-level)
    // -----------------------
    match /matches/{matchId} {

      // Allow create only if the user is included as a participant in the new document.
      // This rule is granular and checks the incoming data.
      allow create: if isSignedIn() && uid() in request.resource.data.participants;

      // Allow get, update, and delete only if the user is a participant in the existing document.
      // This rule checks the already-stored data.
      allow get, update, delete: if isSignedIn() && uid() in resource.data.participants;

      // Allow list (queries) ONLY IF the query explicitly filters for the user's UID in the 'participants' array.
      // This is the key rule that secures collection-level reads.
      allow list: if isSignedIn() && request.query.where[0] == ['participants', 'array-contains', uid()];

      // -----------------------
      // messages subcollection
      // -----------------------
      match /messages/{messageId} {
        function isMatchParticipant() {
          return exists(/databases/$(database)/documents/matches/$(matchId))
            && uid() in get(/databases/$(database)/documents/matches/$(matchId)).data.participants;
        }

        allow get, list: if isSignedIn() && isMatchParticipant();

        allow create: if isSignedIn()
          && isMatchParticipant()
          && request.resource.data.senderId == uid();

        allow update, delete: if false;
      }
    }
  }
}
