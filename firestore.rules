rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }

    // USERS
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn() && uid() == userId;

      match /notifications/{notificationId} {
        allow read, write, delete: if isSignedIn() && uid() == userId;
      }
    }

    // PROJECTS
    match /projects/{projectId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == uid();
      allow update: if isSignedIn() && (resource.data.ownerId == uid() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestedUsers','matchedUsers']));
      allow delete: if isSignedIn() && resource.data.ownerId == uid();
    }

    // MATCHES
    match /matches/{matchId} {
      // A user can read, update, or delete a match document if they are a participant.
      allow get, update, delete: if isSignedIn() && uid() in resource.data.participants;

      // A user can create a match if they are including their own UID in the participants list.
      allow create: if isSignedIn() && uid() in request.resource.data.participants;
      
      // A user can LIST matches only if they query for matches where they are a participant.
      allow list: if isSignedIn() && request.query.where[0] == ['participants', 'array-contains', uid()];

      // MESSAGES SUBCOLLECTION
      match /messages/{messageId} {
        function isParticipant() {
          return exists(/databases/$(database)/documents/matches/$(matchId)) &&
                 uid() in get(/databases/$(database)/documents/matches/$(matchId)).data.participants;
        }

        allow get, list: if isSignedIn() && isParticipant();
        allow create: if isSignedIn() && isParticipant() && request.resource.data.senderId == uid();
        // Disallow updates/deletes to preserve chat history
        allow update, delete: if false;
      }
    }
  }
}
