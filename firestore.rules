rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }

    // USERS
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn() && uid() == userId;

      // Allow a user to list, read, update, or delete their own notifications.
      // Crucially, allow ANY signed-in user to create a notification for another user.
      match /notifications/{notificationId} {
        allow list, read, update, delete: if isSignedIn() && uid() == userId;
        allow create: if isSignedIn();
      }
    }

    // PROJECTS
    match /projects/{projectId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == uid();
      
      // Combined, unambiguous update rule:
      // - The user is the owner, they can change anything.
      // - OR, a non-owner is ONLY changing the 'interestedUsers' array.
      allow update: if isSignedIn() && 
                    (resource.data.ownerId == uid() || 
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestedUsers']));
      
      allow delete: if isSignedIn() && resource.data.ownerId == uid();
    }

    // MATCHES
    match /matches/{matchId} {
      // Allow a user to read, update, or delete a match document if their UID is in participants list.
      allow get, update, delete: if isSignedIn() && uid() in resource.data.participants;

      // Allow create: user must be in participants being created.
      allow create: if isSignedIn()
          && request.resource.data.keys().hasAll(['participants', 'participantsDetails'])
          && request.resource.data.participants is list
          && uid() in request.resource.data.participants;

      // Allow list (query): allow signed-in users to run queries; document-level rules still enforce per-doc access.
      allow list: if isSignedIn();

      // MESSAGES SUBCOLLECTION
      match /messages/{messageId} {
        function isParticipant() {
          return exists(/databases/$(database)/documents/matches/$(matchId))
            && uid() in get(/databases/$(database)/documents/matches/$(matchId)).data.participants;
        }

        allow read, get, list: if isSignedIn() && isParticipant();
        allow create: if isSignedIn() && isParticipant() && request.resource.data.senderId == uid();
        allow update, delete: if false;
      }
    }
  }
}
