rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }

    // USERS
    match /users/{userId} {
      allow get, list: if isSignedIn();
      // Only allow a user to create/update their own profile.
      // Deletion is denied from the client to allow the backend function to clean up.
      allow create, update: if isSignedIn() && uid() == userId;
      allow delete: if false;


      // Allow a user to read, update, or delete their own notifications.
      // Crucially, allow ANY signed-in user to create a notification for another user.
      match /notifications/{notificationId} {
        allow read, list, update, delete: if isSignedIn() && uid() == userId;
        allow create: if isSignedIn();
      }
      
      // Allow any signed-in user to log a view, but only the profile owner can read views.
      match /views/{viewId} {
        allow read, list: if isSignedIn() && uid() == userId;
        allow create: if isSignedIn() && request.resource.data.visitorId == uid();
      }
    }

    // PROJECTS
    match /projects/{projectId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == uid();
      
      // Combined, unambiguous update rule:
      // - The user is the owner, they can change anything.
      // - OR, a non-owner is ONLY changing the 'interestedUsers' or 'rejections' map.
      allow update: if isSignedIn() && 
                    (resource.data.ownerId == uid() || 
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestedUsers', 'rejections']));
      
      allow delete: if isSignedIn() && resource.data.ownerId == uid();

      // Allow any signed-in user to log a view, but only the project owner can read views.
      match /views/{viewId} {
          allow read, list: if isSignedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == uid();
          allow create: if isSignedIn() && request.resource.data.visitorId == uid();
      }
    }

    // ROLES
    match /roles/{roleId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == uid();

      // Allow owner to update any field.
      // Allow non-owners to ONLY update the interestedUsers and rejections fields.
      allow update: if isSignedIn() && 
                    (resource.data.ownerId == uid() || 
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestedUsers', 'rejections']));

      // Only the owner can delete a role.
      allow delete: if isSignedIn() && resource.data.ownerId == uid();
    }

    // BLOGS
    match /blogs/{blogId} {
      // Allow public read access to all posts. The UI will filter for published posts.
      allow get, list: if true;
      // Allow any authenticated user to attempt to write. The admin check is handled in the app's logic.
      allow create, update, delete: if isSignedIn();
    }

    // MATCHES
    match /matches/{matchId} {
      // PERMISSIVE RULE TO FIX DEPLOYMENT CONFLICT.
      // This allows any signed-in user to read/list match documents, but not messages.
      allow read, list: if isSignedIn();
      
      // CREATE rule remains secure
      allow create: if isSignedIn()
          && request.resource.data.keys().hasAll(['participants', 'participantsDetails'])
          && request.resource.data.participants is list
          && uid() in request.resource.data.participants;

      // UPDATE rule remains secure
      allow update: if isSignedIn()
          && uid() in resource.data.participants;

      // Do not allow matches to be deleted from the client. This should be handled by backend functions.
      allow delete: if false;
      
      // Message subcollection
      match /messages/{messageId} {
        function isParticipant() {
          return exists(/databases/$(database)/documents/matches/$(matchId))
            && uid() in get(/databases/$(database)/documents/matches/$(matchId)).data.participants;
        }

        allow read, get, list: if isSignedIn() && isParticipant();
        allow create: if isSignedIn() && isParticipant() && request.resource.data.senderId == uid();
        allow update, delete: if false;
      }
    }
    // FEEDBACK
    match /feedback/{feedbackId} {
      allow create: if isSignedIn();
      // Allow user to read their own feedback, and admin to read all feedback
      allow read, list: if isSignedIn() && (resource.data.userId == uid() || request.auth.token.email == 'dennis.cmuhnene@gmail.com');
      // Only admin can update or delete
      allow update, delete: if isSignedIn() && request.auth.token.email == 'dennis.cmuhnene@gmail.com';
    }
  }
}
