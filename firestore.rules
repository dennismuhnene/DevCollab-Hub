rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }

    // USERS
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn() && uid() == userId;

      // Allow a user to read, update, or delete their own notifications.
      // Allow any signed-in user to create a notification for another user.
      match /notifications/{notificationId} {
        allow read, update, delete: if isSignedIn() && uid() == userId;
        allow create: if isSignedIn();
      }
    }

    // PROJECTS
    match /projects/{projectId} {
      // Basic read permissions for signed-in users
      allow get, list: if isSignedIn();

      // Create: only when the ownerId in new doc equals request.auth.uid
      allow create: if isSignedIn() && request.resource.data.ownerId == uid();

      // Update:
      // - Owner can update any fields on their own project.
      // - Non-owner users may only modify the 'interestedUsers' array.
      allow update: if isSignedIn() && (
        resource.data.ownerId == uid()
        ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestedUsers'])
      );

      // Delete: only owner can delete
      allow delete: if isSignedIn() && resource.data.ownerId == uid();
    }

    // MATCHES
    match /matches/{matchId} {

  // Allow any participant to read this match
  allow read: if isSignedIn() && uid() in resource.data.participants;

  allow create: if isSignedIn() && uid() in request.resource.data.participants;

  // Owner-only update? You had none → keep your update rule:
  // (Might want to revise later)
  allow update: if isSignedIn() && uid() in resource.data.participants;

  allow delete: if false;

  // Allow only array-contains queries for list
  function isQueryingOwnMatches() {
    return request.query.where[0] == ['participants', 'array-contains', uid()];
  }

  allow list: if isSignedIn() && isQueryingOwnMatches();

  // Message subcollection
  match /messages/{messageId} {
    function isParticipant() {
      return exists(/databases/$(database)/documents/matches/$(matchId))
        && uid() in get(/databases/$(database)/documents/matches/$(matchId)).data.participants;
    }

    allow read, get, list: if isSignedIn() && isParticipant();
    allow create: if isSignedIn() && isParticipant() && request.resource.data.senderId == uid();
    allow update, delete: if false;
  }
}

  }
}
