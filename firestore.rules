rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Simple helpers
    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }

    // -----------------------
    // USERS
    // -----------------------
    match /users/{userId} {
      // Any signed-in user may read user profiles (public). If you want to restrict reads,
      // change `allow get: if isSignedIn();` to a more restrictive check.
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // If you prefer to restrict listing, tighten this.

      // Only the owner can create/update/delete their profile document
      allow create, update, delete: if isSignedIn() && uid() == userId;

      // Notifications: only the user can access their own notifications subcollection
      match /notifications/{notificationId} {
        allow read, write, delete: if isSignedIn() && uid() == userId;
      }

      // Optional per-user projects subcollection (if you use it)
      match /projects/{projectId} {
        allow get: if isSignedIn() && uid() == userId;
        allow list: if isSignedIn() && uid() == userId;
        allow create: if isSignedIn() && uid() == userId && request.resource.data.ownerId == userId;
        allow update, delete: if isSignedIn() && uid() == userId && resource.data.ownerId == userId;
      }
    }

    // -----------------------
    // PROJECTS (top-level)
    // -----------------------
    match /projects/{projectId} {
      // Anyone signed in can read public projects (change if you want public read access)
      allow get, list: if isSignedIn();

      // Creation requires the authenticated user to set themselves as the owner
      allow create: if isSignedIn() && request.resource.data.ownerId == uid();

      // Allow update if the user is the owner OR if the update only affects 
      // the interestedUsers/matchedUsers arrays (so others can express interest)
      allow update: if isSignedIn() &&
        (
          // Owner may update any field
          (resource.data.ownerId == uid())
          ||
          // Non-owner may update only allowed fields (express/withdraw interest)
          (
            // Only allow changes that only affect the specified safe keys
            request.resource.data.keys().hasAll(resource.data.keys()) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestedUsers','matchedUsers'])
          )
        );

      // Only owner may delete
      allow delete: if isSignedIn() && resource.data.ownerId == uid();
    }

    // -----------------------
    // MATCHES (top-level)
    // -----------------------
    match /matches/{matchId} {

      /**
       * Create:
       * - Allowed only if caller is signed in AND the request resource includes
       *   a participants array that contains the caller's uid. This prevents
       *   someone from creating a match that doesn't involve themselves.
       */
      allow create: if isSignedIn()
        && request.resource.data.participants is list
        && uid() in request.resource.data.participants
        && request.resource.data.projectId is string
        && request.resource.data.status in ['active','closed']
        && request.resource.data.ownerId is string
        && request.resource.data.matchedUserId is string;

      /**
       * get, update, delete:
       * - Allowed only if the requesting user is one of the participants stored
       *   in the match document already (document-level check).
       */
      allow get, update, delete: if isSignedIn()
        && resource.data.participants is list
        && uid() in resource.data.participants;

      /**
       * list:
       * - Listing the whole collection is sensitive. Only allow client list operations
       *   that include an explicit filter where('participants', 'array-contains', uid()).
       * - Also enforce a reasonable limit (protects against huge scans).
       *
       * Note: The client MUST query with a where('participants', 'array-contains', currentUser.uid)
       * for this rule to permit the listing operation.
       */
      allow list: if isSignedIn()
        && request.query.limit <= 100
        && request.query.where('participants', 'array-contains', uid());

      // -----------------------
      // messages subcollection
      // -----------------------
      match /messages/{messageId} {
        /**
         * For messages, we check the parent match document to determine participation.
         * get(..).data.participants is used to restrict access to participants only.
         */
        function isMatchParticipant() {
          return exists(/databases/$(database)/documents/matches/$(matchId))
            && uid() in get(/databases/$(database)/documents/matches/$(matchId)).data.participants;
        }

        // Reading/listing messages: only participants
        allow get, list: if isSignedIn() && isMatchParticipant();

        // Creating messages: only participants and the senderId must match caller
        allow create: if isSignedIn()
          && isMatchParticipant()
          && request.resource.data.senderId == uid()
          && request.resource.data.text is string
          && request.resource.data.timestamp != null;

        // Disallow update/delete of messages (preserve message history integrity)
        allow update, delete: if false;
      }
    }

    // -----------------------
    // Catch-all: deny by default (implicit)
    // -----------------------
    // All other documents/paths are denied unless a rule above allows them.
  }
}