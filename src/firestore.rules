/**
 * @fileoverview Firestore Security Rules for DevCollab Hub.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and projects.
 * It uses denormalization to avoid costly `get()` calls and ensures authorization independence.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles. User's can only read/write their own profile.
 * - /projects/{projectId}: Stores project information. Only authenticated users can read/write.
 * - /users/{userId}/projects/{projectId}: Subcollection for projects owned by a specific user.
 * - /matches/{matchId}: Stores match data between users and projects.
 * - /projects/{projectId}/matches/{matchId}: Subcollection for matches related to a specific project.
 *
 * Key Security Decisions:
 * - Users can only access their own profile data.
 * - Project modifications are restricted to the project owner.
 * - Denormalization of ownerId and userId ensures authorization independence.
 * - All write operations validate the existence of the document being modified/deleted.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }

    /**
     * @description Controls access to user profiles and their subcollections.
     */
    match /users/{userId} {
      function isOwner() {
        return request.auth.uid == userId;
      }

      // Profile document
      allow get, list: if isSignedIn();
      allow create, update, delete: if isOwner();

      /**
       * @description Controls access to user notifications. Only the owner can access them.
       * @path /users/{userId}/notifications/{notificationId}
       */
      match /notifications/{notificationId} {
        allow read, write, delete: if isOwner();
      }
    }

    /**
     * @description Controls access to top-level projects.
     */
    match /projects/{projectId} {
      function isOwner() {
        return request.auth.uid == resource.data.ownerId;
      }

      function isCreatingAsSelf() {
        return request.auth.uid == request.resource.data.ownerId;
      }

      // Anyone signed in can read or list projects.
      allow get, list: if isSignedIn();

      // Anyone can create a project if they set themselves as the owner.
      allow create: if isSignedIn() && isCreatingAsSelf();

      // Allow updates if the user is the owner OR if they are only modifying the interestedUsers/matchedUsers list.
      allow update: if isSignedIn() &&
        (
          (isOwner())
          ||
          (
            request.resource.data.keys().hasAll(resource.data.keys()) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestedUsers','matchedUsers'])
          )
        );

      // Only the owner can delete.
      allow delete: if isSignedIn() && isOwner();
    }
    
    /**
     * @description Controls access to matches. A user must be a participant to interact.
     * @path /matches/{matchId}
     */
    match /matches/{matchId} {

      // Allow create only if the user is included as a participant in the new document.
      allow create: if isSignedIn() && uid() in request.resource.data.participants;

      // Allow get, update, and delete only if the user is a participant in the existing document.
      allow get, update, delete: if isSignedIn() && uid() in resource.data.participants;

      // Allow list (queries) ONLY IF the query explicitly filters for the user's UID in the 'participants' array.
      allow list: if isSignedIn() && request.query.where[0] == ['participants', 'array-contains', uid()];

      /**
       * @description Controls access to messages within a match. Only participants can read/write.
       * @path /matches/{matchId}/messages/{messageId}
       */
      match /messages/{messageId} {
        function isMatchParticipant() {
          // Check against the parent `match` document's data
          return exists(/databases/$(database)/documents/matches/$(matchId))
            && uid() in get(/databases/$(database)/documents/matches/$(matchId)).data.participants;
        }

        function isMessageSender() {
          return request.auth.uid == request.resource.data.senderId;
        }
    
        allow get, list: if isSignedIn() && isMatchParticipant();
        allow create: if isSignedIn() && isMatchParticipant() && isMessageSender();
        // Disallow updates and deletes for message history integrity
        allow update, delete: if false;
      }
    }
  }
}
