rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }

    // USERS
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn() && uid() == userId;

      // Allow a user to read, update, or delete their own notifications.
      // Crucially, allow ANY signed-in user to create a notification for another user.
      match /notifications/{notificationId} {
        allow read, update, delete: if isSignedIn() && uid() == userId;
        allow create: if isSignedIn();
      }
    }

    // PROJECTS
    match /projects/{projectId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == uid();
      
      // Combined, unambiguous update rule:
      // - The user is the owner, they can change anything.
      // - OR, a non-owner is ONLY changing the 'interestedUsers' array.
      allow update: if isSignedIn() && 
                    (resource.data.ownerId == uid() || 
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestedUsers']));
      
      allow delete: if isSignedIn() && resource.data.ownerId == uid();
    }

    // MATCHES
    match /matches/{matchId} {

      function hasParticipants() {
        return resource.data.keys().hasAll(['participants', 'participantsDetails'])
          && resource.data.participants is list;
      }

      // Allow any participant to read their own match document
      allow get: if isSignedIn() && hasParticipants() && uid() in resource.data.participants;
      
      // Secure rule for LIST: Only allow if the query is filtering by the user's UID.
      allow list: if isSignedIn() && request.query.where[0][2] == uid();

      // When creating a match, the new document must contain a 'participants' map
      // and the current user must be one of the participants.
      allow create: if isSignedIn()
          && request.resource.data.keys().hasAll(['participants', 'participantsDetails'])
          && request.resource.data.participants is list
          && uid() in request.resource.data.participants;

      // Allow participants to update the match (e.g., for last message timestamp)
      allow update: if isSignedIn()
          && hasParticipants()
          && uid() in resource.data.participants;

      // Do not allow matches to be deleted.
      allow delete: if false;
      
      // Message subcollection
      match /messages/{messageId} {
        function isParticipant() {
          return exists(/databases/$(database)/documents/matches/$(matchId))
            && uid() in get(/databases/$(database)/documents/matches/$(matchId)).data.participants;
        }

        allow read, get, list: if isSignedIn() && isParticipant();
        allow create: if isSignedIn() && isParticipant() && request.resource.data.senderId == uid();
        allow update, delete: if false;
      }
    }
  }
}
