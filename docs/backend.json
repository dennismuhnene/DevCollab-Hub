{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user within the DevCollab Hub application.",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique identifier for the User entity."
        },
        "email": {
          "type": "string",
          "description": "User's email address.",
          "format": "email"
        },
        "displayName": {
          "type": "string",
          "description": "User's display name."
        },
        "profileImageUrl": {
          "type": "string",
          "description": "URL of the user's profile image.",
          "format": "uri"
        },
        "skills": {
          "type": "array",
          "description": "List of professional skills possessed by the user.",
          "items": {
            "type": "string"
          }
        },
        "techStack": {
          "type": "array",
          "description": "List of technologies the user is familiar with.",
          "items": {
            "type": "string"
          }
        },
        "yearsOfExperience": {
          "type": "number",
          "description": "The amount of experience in years."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the user account was created.",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "createdAt"
      ]
    },
    "Project": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Project",
      "type": "object",
      "description": "Represents a project created by a user for collaboration.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Project entity."
        },
        "ownerId": {
          "type": "string",
          "description": "Reference to User. (Relationship: User 1:N Project). The ID of the user who owns the project."
        },
        "title": {
          "type": "string",
          "description": "Title of the project."
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the project."
        },
        "requiredTechStack": {
          "type": "array",
          "description": "List of technologies required for the project.",
          "items": {
            "type": "string"
          }
        },
        "requiredSkills": {
          "type": "array",
          "description": "List of professional skills required for the project.",
          "items": {
            "type": "string"
          }
        },
        "requiredYearsOfExperience": {
          "type": "number",
          "description": "The minimum years of experience required for collaborators."
        },
        "collaborationOpen": {
          "type": "boolean",
          "description": "Indicates whether the project is open for collaboration."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the project was created.",
          "format": "date-time"
        },
        "projectImageUrl": {
          "type": "string",
          "description": "URL of the project's image.",
          "format": "uri"
        },
        "interestedUsers": {
          "type": "array",
          "description": "List of user IDs who have shown interest in the project.",
          "items": {
            "type": "string"
          }
        },
        "matchedUsers": {
          "type": "array",
          "description": "List of user IDs who have matched with the project.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "ownerId",
        "title",
        "description",
        "collaborationOpen",
        "createdAt",
        "requiredTechStack",
        "requiredSkills"
      ]
    },
    "Match": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Match",
      "type": "object",
      "description": "Represents a match between a user and a project.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Match entity."
        },
        "projectId": {
          "type": "string",
          "description": "Reference to Project. The ID of the project involved in the match."
        },
        "ownerId": {
          "type": "string",
          "description": "The ID of the project owner."
        },
        "matchedUserId": {
          "type": "string",
          "description": "The ID of the user who was matched."
        },
        "participants": {
            "type": "array",
            "description": "An array containing the UIDs of both participants for easy querying.",
            "items": {
                "type": "string"
            }
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the match was created.",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "description": "Status of the match (e.g., active, closed).",
          "enum": ["active", "closed"]
        },
        "archivedBy": {
          "type": "array",
          "description": "List of user IDs who have archived this match.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "projectId",
        "ownerId",
        "matchedUserId",
        "participants",
        "createdAt",
        "status"
      ]
    },
    "Message": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Message",
      "type": "object",
      "description": "Represents a single chat message within a match.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the message."
        },
        "text": {
          "type": "string",
          "description": "The content of the message."
        },
        "senderId": {
          "type": "string",
          "description": "The UID of the user who sent the message."
        },
        "timestamp": {
          "type": "string",
          "description": "Timestamp indicating when the message was sent.",
          "format": "date-time"
        }
      },
      "required": ["id", "text", "senderId", "timestamp"]
    },
    "Notification": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Notification",
      "type": "object",
      "description": "Represents a notification for a user.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the notification."
        },
        "type": {
          "type": "string",
          "description": "The type of notification.",
          "enum": ["interest", "match", "message"]
        },
        "fromUserId": {
          "type": "string",
          "description": "The UID of the user who triggered the notification."
        },
        "read": {
          "type": "boolean",
          "description": "Indicates whether the notification has been read."
        },
        "timestamp": {
          "type": "string",
          "description": "Timestamp of the notification.",
          "format": "date-time"
        }
      },
      "required": ["id", "type", "fromUserId", "read", "timestamp"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/entities/User"
          },
          "description": "Stores user profiles."
        }
      },
      {
        "path": "/users/{userId}/notifications/{notificationId}",
        "definition": {
            "entityName": "Notification",
            "schema": { "$ref": "#/entities/Notification"},
            "description": "Subcollection for user-specific notifications."
        }
      },
      {
        "path": "/projects/{projectId}",
        "definition": {
          "entityName": "Project",
          "schema": {
            "$ref": "#/entities/Project"
          },
          "description": "Stores project information."
        }
      },
      {
        "path": "/matches/{matchId}",
        "definition": {
          "entityName": "Match",
          "schema": {
            "$ref": "#/entities/Match"
          },
          "description": "Stores match data between users and projects."
        }
      },
      {
        "path": "/matches/{matchId}/messages/{messageId}",
        "definition": {
            "entityName": "Message",
            "schema": { "$ref": "#/entities/Message" },
            "description": "Subcollection for chat messages within a match."
        }
      }
    ]
  }
}
    